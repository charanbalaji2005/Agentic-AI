# ---------- App ----------
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Set to require an X-API-Key header on every /api request (also set NEXT_PUBLIC_API_KEY in the frontend)
API_KEY=
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Groq LLM Provider ----------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PLANNER=openai/gpt-oss-120b
GROQ_MODEL_GENERATOR=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_VALIDATOR=openai/gpt-oss-20b
GROQ_MODEL_CODE=openai/gpt-oss-120b

# ---------- Hugging Face ----------
HF_TOKEN=                       # needed for gated models (Llama, Gemma)
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
# Alternatives: meta-llama/Llama-3.1-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.3,
#               google/gemma-2-9b-it, Qwen/Qwen2.5-7B-Instruct
LLM_DEVICE=auto                 # auto | cuda | cpu | mps
LLM_QUANTIZATION=none           # none | 4bit | 8bit  (bitsandbytes, CUDA only)
LLM_DTYPE=auto
LLM_MAX_CONTEXT=8192
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Alternatives: BAAI/bge-base-en-v1.5, BAAI/bge-m3, intfloat/e5-base-v2, Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Lighter: cross-encoder/ms-marco-MiniLM-L-6-v2
DEVICE=auto

# ---------- Storage ----------
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/agentic_rag
# Quick local run without Postgres:  DATABASE_URL=sqlite+aiosqlite:///./data/rag.db
POSTGRES_PASSWORD=rag
REDIS_URL=
VECTOR_BACKEND=faiss            # faiss | qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
DATA_DIR=./data

# ---------- Chunking & retrieval ----------
CHUNK_STRATEGY=structure        # structure | recursive | fixed | sliding | semantic
CHUNK_SIZE=800
CHUNK_OVERLAP=120
PARENT_CHUNK_SIZE=2400
CONTEXTUAL_HEADERS=true
DENSE_TOP_K=30
SPARSE_TOP_K=30
RERANK_TOP_K=8
MULTI_QUERY_COUNT=3
USE_HYDE=true
CONTEXT_TOKEN_BUDGET=3500

# ---------- Agent loop ----------
MAX_ITERATIONS=3
SUFFICIENCY_THRESHOLD=0.35
CLAIM_SUPPORT_THRESHOLD=0.15
TOOL_TIMEOUT_S=45

# ---------- Web search ----------
# auto = connected search MCP server if any, else DuckDuckGo | mcp | duckduckgo | none
WEB_SEARCH_PROVIDER=auto
DDG_REGION=us-en                # e.g. uk-en, in-en, de-de; wt-wt = no region
DDG_SAFESEARCH=moderate         # on | moderate | off
DDG_MAX_RESULTS=8
DDG_TIMEOUT_S=10
DDG_MAX_RETRIES=2               # retries on rate limit / timeout (exponential backoff)
DDG_RETRY_BACKOFF_S=1.0
DDG_BACKEND=duckduckgo
DDG_FALLBACK_BACKEND=auto       # ddgs metasearch when DuckDuckGo returns nothing; empty disables
DDG_CACHE_TTL_S=300

# ---------- MCP servers ----------
MCP_CONFIG_PATH=./mcp_servers.json
MCP_FS_ROOT=./data/uploads
BRAVE_API_KEY=
# AWS MCP servers read the standard AWS credential chain (AWS_PROFILE / AWS_REGION or env keys)
AWS_PROFILE=
AWS_REGION=us-east-1
# Azure MCP uses your `az login` session or AZURE_* service-principal variables

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# ---------- Auth & users (frontend: copy these into frontend/.env.local) ----------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                # generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=               # Google Cloud Console → APIs & Services → Credentials → OAuth client
GOOGLE_CLIENT_SECRET=           # authorized redirect URI: http://localhost:3000/api/auth/callback/google
MONGODB_URI=                    # mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
